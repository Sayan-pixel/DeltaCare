# Environment Variables Template: DeltaCare API

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Server Port (Hugging Face Spaces expects 7860 in production; local dev uses 8000)
PORT=8000

# CORS Whitelist (comma-separated origins allowed to invoke this API)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting (maximum requests allowed per minute per client IP)
RATE_LIMIT_PER_MINUTE=60

# Model File Path (relative to apps/api directory)
MODEL_PATH=models/model.joblib

# Mathematical Prediction Guardrail (minimum annual premium allowed in USD)
MINIMUM_PREMIUM_FLOOR=1000.00

