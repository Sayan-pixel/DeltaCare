# Environment Variables Template: DeltaCare Web Client

# Base URL of the backend FastAPI service
# Local Development: http://localhost:8000
# Production (Hugging Face Spaces): https://<your-hf-username>-deltacare-api.hf.space
NEXT_PUBLIC_API_URL=http://localhost:8000

# Client-Side Request Timeout in Milliseconds (AbortController threshold)
NEXT_PUBLIC_API_TIMEOUT_MS=20000

# Slider Debounce Delay in Milliseconds
NEXT_PUBLIC_SLIDER_DEBOUNCE_MS=400

