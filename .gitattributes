# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.md text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Git LFS for binary ML model artifacts
*.joblib filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text

